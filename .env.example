# Cấu hình trình duyệt
HEADLESS=false
BROWSER_DATA_DIR=data/browser_session
BROWSER_CHANNEL=

# Cấu hình cào bài viết
SCROLL_DELAY_MIN=2.0
SCROLL_DELAY_MAX=4.5
MAX_POSTS_PER_GROUP=25
TIMEOUT_MS=30000

# Chế độ cào: "search" (tìm theo từ khóa qua URL) hoặc "feed" (quét feed nhóm và lọc từ khóa)
SCRAPE_MODE=search

# Thư mục xuất dữ liệu
OUTPUT_DIR=data/output
